    Wraps the stock panel instead of copying it, so it keeps working
    across plasma6-desktop upgrades.
*/

import QtQuick
import org.kde.plasma.shell
import org.windowscancover as WCC
import "file://@STOCK_SHELL_DIR@/contents/views" as Stock

Stock.Panel {
    id: windowsCanCoverPanel

    WCC.CoverSetting {
        id: coverSetting
        containment: windowsCanCoverPanel.containment?.plasmoid ?? null
    }

    WCC.PanelCover {
        view: panel
        containment: windowsCanCoverPanel.containment?.plasmoid ?? null
        enabled: coverSetting.windowsCanCover && panel.visibilityMode === Panel.WindowsGoBelow
    }
}
